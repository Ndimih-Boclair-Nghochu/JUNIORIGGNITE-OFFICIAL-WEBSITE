# Copy to .env and fill in. In production the server REFUSES to start while
# TOKEN_SECRET or FOUNDER_PASSWORD are still the placeholders below.

# Set to "production" on the server. Enables the safety checks above.
NODE_ENV=production

# Port the API listens on (nginx proxies /api to this port).
PORT=4000

# Founder console credentials. Only used the FIRST time the database is created
# (the password is hashed into data/db.json and never read again).
FOUNDER_EMAIL=founder@juniorignite.app
FOUNDER_PASSWORD=founder123

# Secret used to sign founder session tokens. Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=change-me-in-production

# Where the database file lives. Keep it OUTSIDE the deploy folder so redeploys
# never wipe it (the systemd unit points this at /var/lib/juniorignite).
DATA_DIR=/var/lib/juniorignite

# Restrict browser API access to your site. "*" is fine while testing.
CORS_ORIGIN=https://your-domain

# Shared secret desktop installs must send as the x-telemetry-key header.
# Leave EMPTY to accept telemetry unauthenticated (not recommended in production).
TELEMETRY_KEY=

# Where the download button points, and the version shown on the site.
INSTALLER_URL=/downloads/JuniorIgnite-Setup-1.1.2.exe
APP_VERSION=1.1.2
